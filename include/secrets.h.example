// ============================================================================
// secrets.h.example — copy to secrets.h and fill in your real values
// ============================================================================
// IMPORTANT: secrets.h is gitignored. Never commit your actual credentials.
//
// Usage:
//   cp include/secrets.h.example include/secrets.h
//   vi include/secrets.h
// ============================================================================
#pragma once

// ---- WiFi --------------------------------------------------------------
#define WIFI_SSID          "your-wifi-ssid"
#define WIFI_PASS          "your-wifi-password"

// ---- MQTT broker -------------------------------------------------------
#define MQTT_HOST          "192.168.1.10"     // IP of the mosquitto broker
#define MQTT_PORT          1883

// MQTT auth credentials.
// - If your broker has anonymous access enabled, leave both as "".
// - If your broker requires auth (typical), fill BOTH fields.
// - Symptom of wrong/missing creds: [mqtt] DISCONNECTED reason=5
//   (NOT_AUTHORIZED) looping every few seconds.
// Check your broker config (e.g. /etc/mosquitto/mosquitto.conf, look for
// `allow_anonymous` and `password_file`).
#define MQTT_USER          ""
#define MQTT_PASS          ""

// ---- CBPi4 fermenter target -------------------------------------------
// This is the CBPi4 internal fermenter ID. Find it in the URL of the
// fermenter detail page in CBPi4 web UI, or via:
//   mosquitto_sub -h <broker> -v -t 'cbpi/fermenterupdate/#'
#define FERMENTER_ID       "HEYPZ4kMQDuQcWxLU26vFp"

// ---- Device identity ---------------------------------------------------
// Hostname of THIS ESP board on your network.
// Used in 3 places:
//   1. WiFi hostname (visible in your DHCP server / router admin UI as
//      the device that picked up an IP lease)
//   2. MQTT client ID (visible in mosquitto logs and the broker's
//      connected-clients dashboard)
//   3. Serial boot banner (helps identify which board you're monitoring
//      when several are flashed)
// Must be unique per device when you flash several boards.
// Constraints: <=23 chars (MQTT 3.1 client ID limit), lowercase,
// alphanumeric + hyphen, no spaces, no special chars.
#define DEVICE_NAME        "ferm-tornado"
